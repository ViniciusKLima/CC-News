rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /edicoes/{edicaoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /usuarios/{usuarioId} {
      function souAdministrador() {
        return request.auth != null &&
          get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.perfil == 'administrador';
      }
      allow get: if true;
      allow list: if souAdministrador();
      allow create, delete: if souAdministrador();
      allow update: if souAdministrador() ||
        (request.auth != null && request.auth.token.email == usuarioId);
    }
    // Configuracao de aparencia da plataforma (logo, hero, cores, icones,
    // rodape, banner de encerramento — ver InterfaceConfigService). Leitura
    // publica porque a area publica (Home/Edicao) precisa renderizar essas
    // cores/textos/imagens; escrita restrita a usuarios autenticados, na
    // pratica so administradores chegam la (rota /admin/aparencia protegida
    // por adminRoleGuard no app).
    match /configuracao/{documento} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
